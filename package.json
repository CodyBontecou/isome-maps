{
	"name": "obsidian-iso-me-maps",
	"version": "0.7.3",
	"description": "Obsidian plugin that renders Leaflet maps inline from iso.me location exports.",
	"repository": {
		"type": "git",
		"url": "https://github.com/CodyBontecou/obsidian-iso-me-maps.git"
	},
	"bugs": {
		"url": "https://github.com/CodyBontecou/obsidian-iso-me-maps/issues"
	},
	"homepage": "https://github.com/CodyBontecou/obsidian-iso-me-maps#readme",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"leaflet",
		"maps",
		"iso.me"
	],
	"author": "Cody Bontecou",
	"license": "MIT",
	"devDependencies": {
		"@types/leaflet": "^1.9.21",
		"@types/node": "^22.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"leaflet": "^1.9.4",
		"leaflet.heat": "^0.2.0"
	}
}
